local function popIn(row)
    for i, c in ipairs(row.entry.children) do
        local r = rows[c.name]
        if r then
            r.btn.BackgroundTransparency = 1
            r.label.TextTransparency = 1
            r.dot.BackgroundTransparency = 1
            task.delay((i - 1) * 0.035, function()
                if r.btn.Parent then
                    tw(r.btn, 0.2, {BackgroundTransparency = 0})
                    tw(r.label, 0.2, {TextTransparency = 0})
                    tw(r.dot, 0.2, {BackgroundTransparency = 0})
                end
            end)
        end
    end
end

local function setShown(row, show, animate)
    if row.shown == show then return end
    row.shown = show
    row.kids.Visible = show
    tw(row.chev, 0.22, {Rotation = show and 90 or 0}, Enum.EasingStyle.Back)
    tw(row.pill, 0.2, {BackgroundTransparency = show and 0.6 or 0.82})
    if show and animate then popIn(row) end
end

local function makeGroup(e, parentFrame, order, depth)
    local container = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, LayoutOrder = order,
    }, parentFrame)
    new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, container)

    local head, dot, label = makeRowBase(e, container, depth == 0 and 36 or 32, 1, Enum.Font.GothamBold, 62, GROUP)
