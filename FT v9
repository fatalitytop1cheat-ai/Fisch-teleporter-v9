local function matchName(n, q) return q ~= "" and n:lower():find(q, 1, true) ~= nil end

local function matchNode(e, q)
    if matchName(e.name, q) then return true end
    if e.children then
        for _, c in ipairs(e.children) do
            if matchNode(c, q) then return true end
        end
    end
    return false
end

local function applyNode(e, q, animate, forced)
    local row = rows[e.name]
    if not row then return end
    if e.children then
        local any = matchNode(e, q)
        row.container.Visible = q == "" or forced or any
        local show = (q == "" and row.expanded) or (q ~= "" and any)
        setShown(row, show, animate)
        for _, c in ipairs(e.children) do applyNode(c, q, animate, show and q ~= "") end
    else
        row.btn.Visible = q == "" or forced or matchName(e.name, q)
    end
end

function applyFilter(animate)
    local q = search.Text:lower()
    for _, e in ipairs(tree) do applyNode(e, q, animate, false) end
    footerCredits.Visible = q == ""
    discordChip.Visible = q == ""
end

