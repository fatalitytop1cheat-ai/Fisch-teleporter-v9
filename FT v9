local tabs = {}
local currentTab = 1
local function makeTab(label, i, page)
    local b = new("TextButton", {
        Size = UDim2.new(0.5, 0, 1, -2), Position = UDim2.new((i - 1) * 0.5, 0, 0, 0),
        BackgroundTransparency = 1, Text = label, TextColor3 = MUTED,
        Font = Enum.Font.GothamBold, TextSize = 13, AutoButtonColor = false,
    }, tabBar)
    b.MouseEnter:Connect(function()
        if currentTab ~= i then tw(b, 0.12, {TextColor3 = Color3.fromRGB(200, 206, 226)}) end
    end)
    b.MouseLeave:Connect(function()
        if currentTab ~= i then tw(b, 0.12, {TextColor3 = MUTED}) end
    end)
    tabs[i] = {btn = b, page = page, label = label}
    return b
end

local function switchTab(i, instant)
    for idx, t in ipairs(tabs) do
        tw(t.btn, 0.15, {TextColor3 = idx == i and TEXT or MUTED})
        if idx ~= i then t.page.Visible = false end
    end
    local p = tabs[i].page
    if not instant and currentTab ~= i then
        p.Position = UDim2.new(0, i > currentTab and 18 or -18, 0, 0)
        p.Visible = true
        tw(p, 0.22, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Quint)
    else
        p.Position = UDim2.new(0, 0, 0, 0)
        p.Visible = true
    end
    tw(indicator, 0.25, {Position = UDim2.new((i - 1) * 0.5, 10, 1, -2)}, Enum.EasingStyle.Back)
    currentTab = i
end

