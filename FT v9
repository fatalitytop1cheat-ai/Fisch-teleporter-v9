local function goEntry(e)
    setStatus("Поиск точки: " .. e.name .. "...")
    task.spawn(function()
        local pos = manual[e.name] or e.pos
        local precise = e.gps == true or manual[e.name] ~= nil
        if not pos then
            refreshIndex()
            pos = autoFind(e)
        end
        if not pos then
            setStatus("Нет координат: " .. e.name .. " — сохрани их во вкладке «Мои точки»", BAD)
