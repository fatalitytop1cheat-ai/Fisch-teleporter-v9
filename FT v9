local idx, indexing = {}, false
local function refreshIndex()
    if indexing then return end
    indexing = true
    local fresh, n = {}, 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Model") then
            local k = d.Name:lower()
            if wanted[k] and not fresh[k] then fresh[k] = d end
        end
        n += 1
        if n % 4000 == 0 then task.wait() end
    end
    idx = fresh
    indexing = false
end

local function autoFind(e)
    if e.pos or e.noTp then return nil end
    local ok, tp = pcall(function() return workspace.world.spawns.TpSpots end)
    for _, c in ipairs(candidates(e)) do
        if ok and tp then
            local spot = tp:FindFirstChild(c)
            if spot then
                local p = partPos(spot)
                if p then return p end
            end
        end
        local inst = idx[c:lower()]
        if inst and inst.Parent then
            local p = partPos(inst)
            if p then return p end
        end
    end
end

local function hasPos(e)
    if e.noTp then return false end
    return manual[e.name] ~= nil or e.pos ~= nil or autoFind(e) ~= nil
end

local function rayParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {lp.Character}
    params.IgnoreWater = true
    params.RespectCanCollide = true
    return params
end

local function ray(from, dist)
    return workspace:Raycast(from, Vector3.new(0, -dist, 0), rayParams())
end

local function stream(pos)
    pcall(function() lp:RequestStreamingAroundAsync(pos, 4) end)
end

local busy = false
local prevPos = nil          -- позиция до последнего телепорта (для кнопки «Назад»)

-- cb(state): "busy" | "loading" | "ok" | "nogrnd"
local function teleportPos(pos, gps, cb)
    if busy then cb("busy") return end
    busy = true

    task.spawn(function()
        cb("loading")
        local r = root()
        prevPos = r.Position
        local precise = gps or pos.Y < 80          -- подземелья всегда точные
        local up = Vector3.new(0, 3, 0)

        stream(pos)
        r.AssemblyLinearVelocity = Vector3.zero
        r.Anchored = true                          -- не падаем, пока карта грузится
        r.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))

        local wait = precise and (pos.Y > 90 and 2.5 or 6) or 4
        local deadline = os.clock() + wait
        local final

        while os.clock() < deadline do
            stream(pos)
            if precise then
                -- GPS-точка: земля должна быть почти под ногами
                local hit = ray(pos + Vector3.new(0, 6, 0), 100)
                if hit then
                    if hit.Position.Y >= pos.Y - 14 then
                        final = hit.Position + Vector3.new(0, 3.5, 0)
                    else
                        final = pos + up           -- внизу только дно океана -> встаём на воду
                    end
                    break
                end
            else
                -- центр острова: ищем поверхность сверху, дно океана игнорируем
                local hit = ray(pos + Vector3.new(0, 80, 0), 400)
                if hit then
                    if hit.Position.Y > pos.Y - 25 then
                        final = hit.Position + Vector3.new(0, 3.5, 0)
                    else
                        final = pos + up
                    end
                    break
                end
            end
            task.wait(0.2)
        end

        local ok = final ~= nil
        r.CFrame = CFrame.new(final or (pos + up))
        task.wait(0.15)
        r.AssemblyLinearVelocity = Vector3.zero
        r.Anchored = false
        busy = false
        cb(ok and "ok" or "nogrnd")
    end)
end

