local loadTween
local function startLoad()
    if loadTween then loadTween:Cancel() end
    progress.BackgroundColor3 = ACCENT
    progress.BackgroundTransparency = 0
    progress.Size = UDim2.new(0, 0, 0, 2)
    loadTween = TweenService:Create(progress, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, -1),
        {Size = UDim2.new(1, 0, 0, 2)})
    loadTween:Play()
end

local function stopLoad(ok)
    if loadTween then loadTween:Cancel() loadTween = nil end
    progress.Size = UDim2.new(1, 0, 0, 2)
    progress.BackgroundColor3 = ok and OK or BAD
    progress.BackgroundTransparency = 0
    tw(progress, 0.9, {BackgroundTransparency = 1})
end

local function setStatus(text, color)
    status.Text = text
    status.TextColor3 = color or MUTED
    status.TextTransparency = 1
