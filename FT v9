-- Иконки рисуются из фреймов: шрифт Roblox не знает многие символы (✕ ✦ ＋ показывались как «□»)
local function drawBars(parent, color, size, thickness, rotations, z)
    local holder = new("Frame", {
        Size = UDim2.fromOffset(size, size), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1, ZIndex = z or 1,
    }, parent)
    local bars = {}
    for _, rot in ipairs(rotations) do
        local b = new("Frame", {
            Size = UDim2.fromOffset(math.floor(size * 1.3), thickness), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0), Rotation = rot,
            BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z or 1,
        }, holder)
        round(b, math.max(1, thickness // 2))
        table.insert(bars, b)
    end
    return holder, bars
end

local function drawX(parent, color, size, thickness, z) return drawBars(parent, color, size, thickness, {45, -45}, z) end
local function drawPlus(parent, color, size, thickness, z) return drawBars(parent, color, size, thickness, {0, 90}, z) end

