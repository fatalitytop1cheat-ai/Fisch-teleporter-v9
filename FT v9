    tw(statusDot, 0.2, {BackgroundColor3 = color or MUTED})
end

-- общий обработчик состояний телепорта
local function tpCallback(label)
    return function(state)
        if state == "busy" then
            setStatus("Подожди, предыдущий телепорт ещё идёт", LEGACY)
        elseif state == "loading" then
            startLoad()
            setStatus("Загрузка карты: " .. label .. "...", ACCENT)
        elseif state == "ok" then
            stopLoad(true)
            setStatus("Телепорт: " .. label, OK)
        else
            stopLoad(false)
            setStatus("Земля не прогрузилась, поставил по координатам: " .. label, LEGACY)
        end
    end
end

